# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEBHOOK_URL=

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Alternative Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=

# Gateway Network & Proxy Configuration (Russia Bypass)
# Mode 1: SOCKS5/HTTP Proxy for Telegram API Long Polling
TELEGRAM_PROXY_URL=socks5://user:pass@host:port
# Mode 2: Custom Reverse Proxy / Cloudflare Worker Base URL for Telegram Bot API
TELEGRAM_API_BASE=https://api.telegram.org

# Soul Configuration Path
SOUL_FILE_PATH=./SOUL.md

# Server Configuration
PORT=3000
NODE_ENV=production
