# Gateway Network & Proxy Configuration (No-VPN Russia Bypass)
# Routes both Telegram Long Polling and Foreign AI APIs through application-level proxy
# Supports HTTP CONNECT (http://user:pass@host:port) or SOCKS5 (socks5://user:pass@host:port)
TELEGRAM_PROXY_URL=http://user:pass@host:port
PROXY_URL=http://user:pass@host:port

# Mode 2: Custom Reverse Proxy / Cloudflare Worker Base URL for Telegram Bot API
TELEGRAM_API_BASE=https://api.telegram.org

# Soul Configuration Path
SOUL_FILE_PATH=./SOUL.md

# Server Configuration
PORT=3000
NODE_ENV=production

